# Password tunggal untuk membuka aplikasi. Wajib diset - tanpa ini seluruh
# aplikasi diblokir (lihat src/middleware.ts). Ganti nilainya kapan saja
# untuk langsung membatalkan semua sesi login yang sedang aktif.
APP_PASSWORD=

# --- Database (Turso / libSQL) ---
# Kosongkan keduanya untuk memakai file SQLite lokal (data/wedding.db) -
# cocok untuk `npm run dev`. Isi keduanya untuk memakai Turso di production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Lampiran (Vercel Blob) ---
# Dibuat otomatis oleh Vercel saat Blob store disambungkan ke project ini
# (Storage -> Blob -> Connect Project). Kosongkan untuk memakai folder lokal
# data/attachments/ saat development.
BLOB_READ_WRITE_TOKEN=
